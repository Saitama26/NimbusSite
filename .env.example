# NimbusSite Environment Variables
# ============================================
# Скопируйте этот файл в .env и настройте значения под ваше окружение
# cp envText.txt .env

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=sqlPassword123
MYSQL_DATABASE=NimbusSite_Tenants
MYSQL_PORT_EXTERNAL=3307
SEED_DATA=true

# ============================================
# ASP.NET Core Configuration
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=domain-events

# ============================================
# Database Connection Strings
# ============================================
# Центральная БД для каталога тенантов (обязательно)
# В Docker сети используйте имя сервиса 'mysql' вместо 'localhost'
TENANTS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=NimbusSite_Tenants;User=root;Password=sqlPassword123;CharSet=utf8mb4;


# ============================================
# JWT Configuration
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
JWT_ISSUER=NimbusSite
JWT_AUDIENCE=NimbusSite-Users
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ============================================
# API Ports
# ============================================
TENANTS_API_PORT=5001
USERS_API_PORT=5002
PROJECTS_API_PORT=5003
TASKS_API_PORT=5004
IDENTITY_API_PORT=5005
ACCESSPERMISSIONS_API_PORT=5006
