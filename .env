# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=domain-events

# Tenants DB (catalog + shard map)
TENANTS_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_Tenants;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# Users DB
USERS_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_Users;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# Identity DB
IDENTITY_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_Identity;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# Projects DB
PROJECTS_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_Projects;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# Tasks DB
TASKS_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_Tasks;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# AccessPermissions DB
ACCESSPERMISSIONS_DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=NimbusSite_AccessPermissions;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# JWT (Identity)
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long-for-security
JWT_ISSUER=NimbusSite.Identity
JWT_AUDIENCE=NimbusSite.Users
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173