# ============================================
# NimbusSite Environment Variables
# ============================================
# Скопируйте этот файл в .env и настройте значения под ваше окружение
# cp .env.example .env
#
# Docker Compose автоматически загружает переменные из .env файла
# Переменные передаются в контейнеры через синтаксис ${VARIABLE_NAME}
# Значения по умолчанию можно указать через ${VARIABLE_NAME:-default_value}

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=sqlPassword123
MYSQL_DATABASE=NimbusSite_Tenants
MYSQL_PORT_EXTERNAL=3307
SEED_DATA=true

# ============================================
# ASP.NET Core Configuration
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=domain-events

# ============================================
# Database Connection Strings
# ============================================
# Формат: Server=mysql;Port=3306;Database=<DatabaseName>;User=root;Password=<MYSQL_ROOT_PASSWORD>;CharSet=utf8mb4;

# Центральная БД для каталога тенантов (обязательно)
# Эта БД создается автоматически при первом запуске MySQL контейнера
# Используется для хранения метаданных тенантов и ShardMap
TENANTS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=NimbusSite_Tenants;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# ============================================
# Connection Strings для миграций (опционально, только для разработки)
# ============================================
# Эти переменные используются ТОЛЬКО для миграций EF Core (DesignTimeDbContextFactory)
# и автоматического применения миграций при старте в Development режиме.

USERS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=Tenant_1;User=root;Password=sqlPassword123;CharSet=utf8mb4;
PROJECTS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=Tenant_1;User=root;Password=sqlPassword123;CharSet=utf8mb4;
TASKS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=Tenant_1;User=root;Password=sqlPassword123;CharSet=utf8mb4;
IDENTITY_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=Tenant_1;User=root;Password=sqlPassword123;CharSet=utf8mb4;
ACCESSPERMISSIONS_DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=Tenant_1;User=root;Password=sqlPassword123;CharSet=utf8mb4;

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
JWT_ISSUER=NimbusSite
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ============================================
# API Ports
# ============================================
TENANTS_API_PORT=5001
USERS_API_PORT=5002
PROJECTS_API_PORT=5003
TASKS_API_PORT=5004
IDENTITY_API_PORT=5005
ACCESSPERMISSIONS_API_PORT=5006
